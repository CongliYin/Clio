# ========================================
# Clio 开发环境配置
# 本地开发：所有地址指向 localhost
# 迁移上线：将 localhost 改为服务器 IP
# ========================================

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=clio_db
PG_USER=clio
PG_PASSWORD=clio_dev_2026
DATABASE_URL=postgresql://clio:clio_dev_2026@localhost:5432/clio_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=clio_dev_2026
REDIS_URL=redis://:clio_dev_2026@localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Embedding / Reranker（任务⑭ 合并后可用）
EMBEDDING_URL=http://localhost:8001
RERANKER_URL=http://localhost:8002

# 推理设备：cpu（Mac 本地）/ cuda（Linux GPU）/ mps（Mac GPU 加速，可选）
DEVICE=cpu
